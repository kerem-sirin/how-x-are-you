  text:
    en: What is the most Polish topping to put on pizza?
    native: Jaki jest najbardziej polski dodatek do pizzy?
  visual: {fileID: 0}
  useImageAnswers: 0
  answers:
  - text:
      en: Pineapple
      native: Ananas
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Garlic Sauce
      native: Sos czosnkowy
    image: {fileID: 0}
    isCorrect: 1
  - text:
      en: Pepperoni
      native: Pepperoni
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Olive Oil
      native: Oliwa
    image: {fileID: 0}
    isCorrect: 0
  explanation:
    en: "In Poland, we drown pizza in thick white garlic sauce. It\u2019s basically
      law."
    native: "W Polsce topimy pizz\u0119 w g\u0119stym, bia\u0142ym sosie czosnkowym.
