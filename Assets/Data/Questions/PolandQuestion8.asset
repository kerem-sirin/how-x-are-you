  m_Script: {fileID: 11500000, guid: b35019a955b4c3c49b8eea6f9e439ec9, type: 3}
  m_Name: PolandQuestion8
  m_EditorClassIdentifier: Assembly-CSharp::HowX.Data.QuestionData
  text:
    en: You are on a PKP train. What is the first thing you do?
    native: "Jeste\u015B w poci\u0105gu PKP. Co robisz jako pierwsze?"
  visual: {fileID: 21300000, guid: 38095c83b1ebe56448562a1bf17dd027, type: 3}
  useImageAnswers: 0
  answers:
  - text:
      en: Read a book quietly
      native: "Cicho czytasz ksi\u0105\u017Ck\u0119"
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Take off your shoes and eat a hard-boiled egg
      native: Zdejmujesz buty i jesz jajko na twardo
    image: {fileID: 0}
    isCorrect: 1
  - text:
      en: Drink water
      native: "Pijesz wod\u0119"
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Hack the mainframe
      native: "W\u0142amujesz si\u0119 do systemu"
    image: {fileID: 0}
    isCorrect: 0
  explanation:
    en: The smell of sausage and eggs is the signature scent of long-distance Polish
      travel.
    native: "Zapach kie\u0142basy i jajek to wizyt\xF3wka polskich podr\xF3\u017Cy
      dalekobie\u017Cnych."
