  m_Name: PolandQuestion14
  m_EditorClassIdentifier: Assembly-CSharp::HowX.Data.QuestionData
  text:
    en: ' What do Poles store in a bag full of bags?'
    native: "Co Polacy trzymaj\u0105 w torbie pe\u0142nej toreb?"
  visual: {fileID: 0}
  useImageAnswers: 0
  answers:
  - text:
      en: Old documents
      native: Stare dokumenty
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Christmas decorations
      native: "Ozdoby \u015Bwi\u0105teczne"
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: More plastic bags
      native: "Wi\u0119cej reklam\xF3wek"
    image: {fileID: 0}
    isCorrect: 1
  - text:
      en: 'Shoes '
      native: Buty
    image: {fileID: 0}
    isCorrect: 0
  explanation:
    en: "The legendary bag of bags exists in every Polish home. Its only purpose
      is to store\u2026 more bags. No one remembers when it started."
    native: "Legendarna torba z torbami istnieje w ka\u017Cdym polskim domu. Jej
      jedynym celem jest przechowywanie\u2026 kolejnych toreb. Nikt nie pami\u0119ta,
      kiedy to si\u0119 zacz\u0119\u0142o."
