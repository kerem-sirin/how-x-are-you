  text:
    en: What is the currency of Poland?
    native: Jaka jest waluta Polski?
  visual: {fileID: 0}
  useImageAnswers: 0
  answers:
  - text:
      en: Euro
      native: Euro
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: Zloty
      native: "Z\u0142oty"
    image: {fileID: 0}
