    image: {fileID: 0}
    isCorrect: 1
  - text:
      en: ...I see nothing
      native: "...nic nie widz\u0119"
    image: {fileID: 0}
    isCorrect: 0
  - text:
      en: ...I am in heaven
      native: ...jestem w niebie
    image: {fileID: 0}
    isCorrect: 0
  - text:
