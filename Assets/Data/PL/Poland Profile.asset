  questions:
  - id: 01
    questionText:
      en: What is the capital?
      native: Jaka jest stolica?
    questionVisual: {fileID: 0}
    answer0:
      en: Warsaw
      native: Warszawa
    answer0_Image: {fileID: 0}
    answer1:
      en: Krakow
      native: "Krak\xF3w"
    answer1_Image: {fileID: 0}
    answer2:
      en: Gdansk
      native: "Gda\u0144sk"
    answer2_Image: {fileID: 0}
    answer3:
