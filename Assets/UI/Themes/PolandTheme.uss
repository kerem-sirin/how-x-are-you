/* POLAND SPECIFIC OVERRIDES */

/* Main Background (Optional: If you name your Root element 'Root') */
#Root {
    background-color: rgb(255, 255, 255); /* Pure White Background */
}

/* Buttons become Red with White Text */
Button {
    background-color: rgb(220, 20, 60); /* Crimson Red */
    border-color: rgb(139, 0, 0);       /* Darker Red Border */
    color: rgb(255, 255, 255);          /* White Text */
}

Button:hover {
    background-color: rgb(255, 50, 80); /* Lighter Red on Hover */
}

Button:active {
    background-color: rgb(180, 0, 0); /* Dark Red on Click */
}

/* The Title Text needs to be Red to match */
#Lbl_Title {
    color: rgb(220, 20, 60);
}

/* Result Title should be Gold or Red */
#Lbl_ResultTitle {
    color: rgb(220, 20, 60);
    font-size: 70px;
}