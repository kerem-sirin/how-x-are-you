/* ================= VARIABLES & DEFAULTS ================= */
:root {
    /* Core Colors - Change these to re-theme the game */
    --main-color: rgb(220, 20, 60);       /* Crimson Red (Poland) */
    --main-dark: rgb(180, 0, 0);          /* Darker Red */
    --accent-color: rgb(255, 215, 0);     /* Gold/Yellow for highlights */
    --text-color: rgb(50, 50, 50);        /* Dark Grey */
    --bg-color: rgb(245, 245, 245);       /* Off-White Background */
    --neutral-grey: rgb(230, 230, 230);   /* Button Backgrounds */
    
    /* Spacing & Radius */
    --radius-lg: 20px;
    --radius-md: 12px;
}

/* Global Reset */
Label {
    color: var(--text-color);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* ================= PROGRESS BAR (Pinned Top) ================= */
.progress-container {
    height: 12px;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.1);
    position: absolute;
    top: 0;
    left: 0;
    /* Ensure it sits above the menu but below the transition curtain */
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--main-color);
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-circ;
    border-bottom-right-radius: 4px;
    border-top-right-radius: 4px;
}

/* ================= MENU CONTAINER ================= */
#Container_Menu {
    justify-content: center;
    align-items: center;
    padding: 40px;
    background-color: var(--bg-color);
}

#Lbl_Title {
    font-size: 72px;
    color: var(--main-color);
    margin-bottom: 60px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 2px 2px 0px rgba(0,0,0,0.1);
}

/* ================= QUIZ CONTAINER (The 40/60 Split) ================= */
#Container_Quiz {
    flex-direction: column;
    background-color: var(--bg-color);
    
    /* Animation Physics */
    transition-property: opacity, translate;
    transition-duration: 0.225s;
    transition-timing-function: ease-in-out;
}

/* --- TOP SECTION (40%) --- */
#Box_Question {
    height: 40%;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding: 20px 40px;
    background-color: white;
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
    
    /* Subtle shadow to separate question from answers */
    border-bottom-width: 4px;
    border-bottom-color: rgba(0,0,0,0.05);
}

#Lbl_QuestionText {
    font-size: 36px; /* Slightly smaller for better fit */
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    color: var(--text-color);
}

#Img_QuestionVisual {
    height: 70%;
    width: 90%;
    margin-top: 15px;
    border-radius: var(--radius-md);
    -unity-background-scale-mode: scale-to-fit;
}

/* --- BOTTOM SECTION (60%) --- */
#Grid_Answers {
    height: 60%;
    width: 100%;
    padding: 20px;
    justify-content: center;
}

/* ================= ADAPTIVE LAYOUTS ================= */

/* MODE A: TEXT LIST (Vertical Stack) */
.layout-list {
    flex-direction: column;
    justify-content: space-evenly;
}

.layout-list Button {
    width: 100%;
    height: 22%; /* 4 buttons with spacing = ~88% + margins */
    flex-direction: row; /* In case we add icons later */
}

.layout-list #Img_Ans { display: none; }

/* MODE B: IMAGE GRID (2x2) */
.layout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

.layout-grid Button {
    width: 48%;  /* 2 per row */
    height: 48%; /* 2 per col */
    padding: 10px;
}

.layout-grid #Lbl_Ans { display: none; }
.layout-grid #Img_Ans {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* ================= BUTTON STYLES ================= */
Button {
    border-width: 0px;
    border-radius: var(--radius-md);
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text-color);
    background-color: white;
    
    /* Modern "Card" look */
    border-bottom-width: 6px;
    border-bottom-color: rgba(0,0,0,0.1);
    
    transition-duration: 0.1s;
    transition-property: scale, background-color, border-bottom-color;
    transition-timing-function: ease-out-back;
}

/* Hover */
Button:hover {
    scale: 1.02;
    background-color: white;
    border-bottom-color: var(--main-color); /* Highlight color on hover */
}

/* Active (Pressed) */
Button:active {
    scale: 0.96;
    background-color: var(--neutral-grey);
    border-bottom-width: 2px; /* Press effect */
    translate: 0 4px; /* Physical press movement */
}

/* ================= RESULT SCREEN ================= */
#Container_Result {
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.95);
    padding: 40px;
}

#Box_Result {
    width: 100%;
    max-width: 600px; /* Prevent it from getting too wide on PC */
    align-items: center;
}

#Lbl_Score {
    font-size: 140px;
    color: var(--main-color);
    text-shadow: 4px 4px 0px rgba(0,0,0,0.1);
    margin-bottom: 0px;
}

#Lbl_ResultTitle {
    font-size: 48px;
    margin-bottom: 20px;
    color: var(--text-color);
    white-space: normal;
    -unity-text-align: middle-center;
}

#Lbl_ResultDesc {
    font-size: 24px;
    margin-bottom: 50px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(100, 100, 100);
    line-height: 1.2; /* Better readability */
}

#Btn_Restart {
    width: 80%;
    height: 80px;
    background-color: var(--text-color);
    color: white;
    font-size: 36px;
    border-bottom-color: black;
}

#Btn_Restart:hover {
    background-color: var(--main-color);
    border-bottom-color: var(--main-dark);
}

/* ================= UTILITY & ANIMATION STATES ================= */
#Panel_Transition {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    background-color: var(--main-color); /* Transition color matches theme */
    display: flex;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

.curtain-hidden { opacity: 0; }

.quiz-center { opacity: 1; translate: 0 0; }
.quiz-right  { opacity: 0; translate: 100% 0; }
.quiz-left   { opacity: 0; translate: -100% 0; }
