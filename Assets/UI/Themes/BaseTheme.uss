/* ================= GLOBAL SETTINGS ================= */
Label {
    color: rgb(50, 50, 50);
    -unity-font-style: bold;
}

/* ================= MENU STYLES ================= */

#Container_Menu {
    justify-content: center;
    align-items: center;
    padding: 40px;
}

/* 2. Big Title Styling */
#Lbl_Title {
    font-size: 65px;
    margin-bottom: 60px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
}

/* ================= BUTTON STYLES ================= */
Button {
    border-radius: 15px;
    border-width: 4px;
    font-size: 32px;
    -unity-font-style: bold;
    background-color: rgb(230, 230, 230);
    border-color: rgb(180, 180, 180);
    scale: 1;
    transition-duration: 0.1s;
    transition-property: scale;
    margin: 10px;
    justify-content: center; 
    align-items: center;     
}

Button:hover { scale: 1.05; }
Button:active { scale: 0.95; }


#Lbl_Ans {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
}

/* ================= QUIZ LAYOUT (The 40/60 Split) ================= */

/* 1. TOP AREA (Always 40%) */
#Box_Question {
    height: 40%;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

#Lbl_QuestionText {
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 90%;
    flex-shrink: 0; 
}

#Img_QuestionVisual {
    height: 60%;
    width: 80%;
    margin-top: 20px;
    scale-mode: scale-to-fit;
}

/* 2. BOTTOM AREA (Always 60%) */
#Grid_Answers {
    height: 60%;
    width: 100%;
    padding: 20px;
}

/* ================= LAYOUT MODES (Controlled by C#) ================= */

/* MODE: LIST (For Text Answers) */
.layout-list {
    flex-direction: column;
    justify-content: space-evenly;
}

.layout-list Button {
    width: 100%;
    height: 22%; /* 4 buttons * 22% = 88% height filled */
}

/* MODE: GRID (For Image Answers) */
.layout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

.layout-grid Button {
    width: 48%;   /* Fits 2 side-by-side */
    height: 48%;  /* Fits 2 rows */
    margin: 1%;
}

/* Helper to hide unused elements */
.layout-grid #Lbl_Ans { display: none; }
.layout-list #Img_Ans { display: none; }