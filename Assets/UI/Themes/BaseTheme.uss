/* ================= VARIABLES & DEFAULTS ================= */
:root {
    /* --- PALETTE: "Boho Matte" --- */
    
    /* BACKGROUNDS */
    --theme-bg: rgb(231, 158, 133);       /* Terra Cotta (Main Background) */
    --card-bg: rgba(255, 248, 245, 0.95); /* Warm White (Cards) */
    
    /* ACCENTS & INTERACTION */
    --theme-accent: rgb(56, 115, 115);    /* Deep Teal (Progress, Borders, Hover Text) */
    --hover-bg: rgb(240, 213, 154);       /* Maize Yellow (Hover Background) */
    
    /* TYPOGRAPHY */
    --text-main: rgb(56, 115, 115);       /* Deep Teal (Headings, Score) */
    --text-body: rgb(166, 112, 93);       /* Muted Clay (Questions, Button Idle) */
    
    /* GEOMETRY */
    --radius-lg: 24px;
    --radius-md: 16px;
}

/* Global Reset */
Label {
    color: var(--text-main);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

#Root {
    background-color: var(--theme-bg);
}

/* ================= UTILITIES ================= */
.progress-container {
    height: 12px;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.3);
    position: absolute;
    top: 0; left: 0;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--theme-accent);
    border-bottom-right-radius: 6px;
    border-top-right-radius: 6px;
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-circ;
}

/* ================= MAIN MENU ================= */
#Container_Menu {
    justify-content: flex-start;
    align-items: center;
    padding-top: 20%;
    padding-bottom: 40px;
    padding-left: 40px;
    padding-right: 40px;
    background-color: var(--theme-bg);
}

#Lbl_Title {
    font-size: 60px;
    color: var(--text-main);
    -unity-text-align: middle-center;
    white-space: normal;
    
    /* Generic shadow works with any color */
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.1); 
    
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-lg);
    padding: 30px;
    width: 100%;
    margin-bottom: 80px;
    border-width: 2px;
    border-color: var(--theme-accent);
}

#Container_Menu Button {
    width: 60%;
    max-width: 500px;
    height: 85px;
    margin-bottom: 40px;
    font-size: 36px;
}

/* ================= QUIZ AREA ================= */
#Container_Quiz {
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    transition-property: opacity, translate;
    transition-duration: 0.225s;
    transition-timing-function: ease-in-out;
}

#Box_Question {
    height: 40%;
    width: 92%;
    margin-top: 15px;
    align-self: center;
    justify-content: center;
    align-items: center;
    padding: 30px;
    background-color: rgb(255, 255, 255);
    border-radius: var(--radius-lg);
}

#Lbl_QuestionText {
    font-size: 38px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    
    /* Using Body Color (Clay) */
    color: var(--text-body); 
    
    /* Subtle white highlight instead of dark shadow for "engraved" look */
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8); 
}

#Img_QuestionVisual {
    height: 70%;
    width: 90%;
    margin-top: 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

#Grid_Answers {
    height: 60%;
    width: 100%;
    padding: 20px;
    justify-content: center;
}

/* ================= BUTTONS (Semantic) ================= */
Button {
    border-width: 1px;
    border-color: var(--text-body); /* Clay Border */
    border-radius: var(--radius-md);
    font-size: 28px;
    
    /* Add breathing room for text */
    padding-left: 24px;
    padding-right: 24px;

    /* Clean text, removed muddy purple shadow */
    text-shadow: none; 
    
    /* Idle Text: Clay Color */
    color: var(--text-body); 
    -unity-font-style: bold;
    
    background-color: white;
    transition-duration: 0.2s;
    transition-property: scale, background-color, translate, color, border-color;
    transition-timing-function: ease-out;
}

/* Ensure nested labels match parent button color */
Button Label {
    color: var(--text-body);
    -unity-font-style: bold;
}

/* HOVER: Background becomes Maize, Text becomes Teal */
Button:hover {
    scale: 1.02;
    background-color: var(--hover-bg);
    color: var(--theme-accent);
    border-color: var(--theme-accent);
    translate: 0 -5px;
}

Button:hover Label {
    color: var(--theme-accent);
}

/* ACTIVE: Pressed */
Button:active {
    scale: 0.98;
    translate: 0 1px;
    color: var(--theme-accent);
    border-color: var(--theme-accent);
    border-bottom-width: 0;
}

Button:active Label {
    color: var(--theme-accent);
}

/* ================= RESULT SCREEN ================= */
#Container_Result {
    justify-content: center;
    align-items: center;
    background-color: var(--theme-bg);
    padding: 40px;
    flex-direction: column;
}

#Box_Result {
    width: 100%;
    max-width: 600px;
    align-items: center;
    background-color: var(--card-bg);
    padding: 40px;
    border-radius: var(--radius-lg);
}

#Lbl_Score {
    font-size: 140px;
    
    /* Score is Main Color (Teal) */
    color: var(--text-main); 
    margin-bottom: 0;
    
    /* Soft shadow, not purple */
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.1); 
}

#Lbl_ResultTitle {
    font-size: 48px;
    margin-bottom: 20px;
    color: var(--text-main);
    white-space: normal;
    -unity-text-align: middle-center;
}

#Lbl_ResultDesc {
    font-size: 24px;
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    
    /* Desc is Body Color (Clay) */
    color: var(--text-body); 
    line-height: 1.4;
}

#Btn_Restart {
    width: 80%;
    max-width: 400px;
    height: 80px;
    font-size: 36px;
    margin-top: 40px;
}

/* ================= UTILITY & ANIMATION STATES ================= */
#Panel_Transition {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    
    /* Transition curtain is the Accent Color */
    background-color: var(--theme-accent); 
    
    display: flex;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

/* Layout Classes */
.layout-list { flex-direction: column; justify-content: space-evenly; }
.layout-list Button { width: 100%; height: 22%; flex-direction: row; }
.layout-list #Img_Ans { display: none; }

.layout-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-content: space-between; }
.layout-grid Button { width: 48%; height: 48%; padding: 10px; }
.layout-grid #Lbl_Ans { display: none; }
.layout-grid #Img_Ans { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }

.curtain-hidden { opacity: 0; }
.quiz-center { opacity: 1; translate: 0 0; }
.quiz-right { opacity: 0; translate: 100% 0; }
.quiz-left { opacity: 0; translate: -100% 0; }