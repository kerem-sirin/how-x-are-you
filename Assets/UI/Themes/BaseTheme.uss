Label {
    color: rgb(50, 50, 50);
    -unity-font-style: bold;
}

#Container_Menu {
    justify-content: center;
    align-items: center;
    padding: 40px;
}

#Lbl_Title {
    font-size: 65px;
    margin-bottom: 60px;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
}

Button {
    border-radius: 15px;
    border-width: 4px;
    font-size: 32px;
    -unity-font-style: bold;
    background-color: rgb(230, 230, 230);
    border-color: rgb(180, 180, 180);
    scale: 1;
    transition-duration: 0.1s;
    transition-property: scale;
    transition-timing-function: ease-out-back;
    margin: 10px;
    justify-content: center;
    align-items: center;
}

/* HOVER STATE */
Button:hover {
    scale: 1.05;
    /* Hover can be slower/smoother */
    transition-duration: 0.2s; 
}

/* CLICK STATE (The Press) */
Button:active {
    scale: 0.95;
    
    /* 2. Instantly shrink when pressed (Snappy!) */
    transition-duration: 0.1s; 
}

#Lbl_Ans {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
}

#Box_Question {
    height: 40%;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

#Lbl_QuestionText {
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 90%;
    flex-shrink: 0;
}

#Img_QuestionVisual {
    height: 60%;
    width: 80%;
    margin-top: 20px;
    scale-mode: scale-to-fit;
}

#Grid_Answers {
    height: 60%;
    width: 100%;
    padding: 20px;
}

.layout-list {
    flex-direction: column;
    justify-content: space-evenly;
}

.layout-list Button {
    width: 100%;
    height: 22%;
}

.layout-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

.layout-grid Button {
    width: 48%;
    height: 48%;
    margin: 1%;
}

.layout-grid #Lbl_Ans {
    display: none;
}

.layout-list #Img_Ans {
    display: none;
}

/* ================= RESULT SCREEN ================= */
#Container_Result {
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.9); /* Slight overlay effect */
}

#Box_Result {
    width: 80%;
    align-items: center; /* Center text horizontally */
    justify-content: center;
}

#Lbl_Score {
    font-size: 120px;       /* Massive score text */
    color: rgb(220, 20, 60); /* Crimson Red (Matches Poland Theme) */
    margin-bottom: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#Lbl_ResultTitle {
    font-size: 50px;
    margin-bottom: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

#Lbl_ResultDesc {
    font-size: 30px;
    margin-bottom: 50px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(80, 80, 80);
}

/* Make the restart button distinct */
#Btn_Restart {
    width: 60%;
    background-color: rgb(50, 50, 50); /* Dark Grey */
    color: white;
    border-color: black;
}

#Btn_Restart:hover {
    background-color: rgb(80, 80, 80);
    scale: 1.05;
}

/* ================= CURTAIN TRANSITION ================= */
/* 1. The Container (Layout & Animation Settings ONLY) */
#Panel_Transition {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    background-color: black;
    
    /* Ensure it's always in the visual tree */
    display: flex; 
    
    /* Define the animation */
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out;
}

/* 2. The "Hidden" State */
.curtain-hidden {
    opacity: 0;
}

